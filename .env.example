NODE_ENV=production

# Network interface and port used by the custom Next.js and Socket.IO server.
HOST=0.0.0.0
PORT=3000

# Optional persistent, writable directory for server-side custom pack JSON files.
# Leave unset to use data/custom-packs relative to the project directory.
CUSTOM_PACKS_DIR=/data/custom-packs

# Required in production. Replace this value with a strong deployment secret.
PACK_ADMIN_PASSWORD=change-me
